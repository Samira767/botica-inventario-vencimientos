# Copia este archivo como .env
# Estos valores coinciden con docker-compose.yml (base local)
DATABASE_URL="postgresql://botica:botica@localhost:5432/botica"

# Clave para firmar los tokens. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

PORT=3001
