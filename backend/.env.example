# Copia este archivo como .env
# Estos valores coinciden con docker-compose.yml (base local)
DATABASE_URL="postgresql://botica:botica@localhost:5432/botica"

# Opcional. Las pruebas e2e usan la base botica_test del mismo servidor;
# define esta variable solo si quieres otra (el nombre debe terminar en _test).
# DATABASE_URL_TEST="postgresql://botica:botica@localhost:5432/botica_test"

# Clave para firmar los tokens. Genera una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
JWT_EXPIRES_IN="8h"

PORT=3001
